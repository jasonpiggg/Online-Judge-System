OJ_DATABASE_PATH=var/oj.db
OJ_PROBLEM_DIR=var/problems
OJ_SEED_PROBLEM_DIR=data/problem_seeds
OJ_SESSION_COOKIE=oj_session
OJ_SESSION_TTL_SECONDS=28800
OJ_COOKIE_SECURE=false
OJ_AI_ENCRYPTION_KEY=
# Optional system-wide default. All three fields plus a stable encryption key are required.
# Imported into encrypted database storage on first startup only; never commit real keys.
OJ_AI_DEFAULT_PROVIDER_URL=
OJ_AI_DEFAULT_MODEL=
OJ_AI_DEFAULT_API_KEY=
OJ_AI_DEFAULT_INPUT_PRICE=0
OJ_AI_DEFAULT_OUTPUT_PRICE=0
OJ_AI_DEFAULT_PRICE_UNIT=1000000
OJ_AI_DEFAULT_CURRENCY=USD
# Omit to bill cached input at the ordinary input rate.
# OJ_AI_DEFAULT_CACHED_INPUT_PRICE=0
# Optional high-quality profile; shares system URL/key/currency/token unit.
OJ_AI_ROUTING_ENABLED=false
# Optional provider-specific settings; omit for providers that do not support them.
# OJ_AI_DEFAULT_REASONING_EFFORT=high
# OJ_AI_QUALITY_REASONING_EFFORT=high
OJ_AI_DEFAULT_JSON_MODE=true
OJ_AI_QUALITY_JSON_MODE=true
OJ_AI_QUALITY_MODEL=
OJ_AI_QUALITY_INPUT_PRICE=0
OJ_AI_QUALITY_OUTPUT_PRICE=0
# OJ_AI_QUALITY_CACHED_INPUT_PRICE=0
OJ_AI_MAX_OUTPUT_TOKENS=16384
OJ_AI_SECTION_MAX_OUTPUT_TOKENS=8192
# Increase for reasoning models if needed (maximum stage 1800 / task 7200 seconds).
OJ_AI_STREAM_READ_TIMEOUT_SECONDS=90
OJ_AI_STAGE_TIMEOUT_SECONDS=120
OJ_AI_TASK_TIMEOUT_SECONDS=300
OJ_ALLOW_PRIVATE_AI_ENDPOINTS=false
OJ_API_URL=http://127.0.0.1:8000
