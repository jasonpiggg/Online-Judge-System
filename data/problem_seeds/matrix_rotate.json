{
  "id": "matrix_rotate",
  "title": "矩阵旋转",
  "description": "将 n×m 整数矩阵顺时针旋转 90 度。",
  "input_description": "第一行 n m，随后 n 行矩阵。",
  "output_description": "输出旋转后的 m×n 矩阵。",
  "samples": [
    {
      "input": "1 1\n5\n",
      "output": "5\n"
    },
    {
      "input": "2 3\n1 2 3\n4 5 6\n",
      "output": "4 1\n5 2\n6 3\n"
    }
  ],
  "constraints": "1 ≤ n,m ≤ 500。",
  "testcases": [
    {
      "input": "1 1\n5\n",
      "output": "5\n"
    },
    {
      "input": "2 3\n1 2 3\n4 5 6\n",
      "output": "4 1\n5 2\n6 3\n"
    },
    {
      "input": "3 1\n1\n2\n3\n",
      "output": "3 2 1\n"
    },
    {
      "input": "2 2\n-1 0\n2 3\n",
      "output": "2 -1\n3 0\n"
    },
    {
      "input": "1 4\n1 2 3 4\n",
      "output": "1\n2\n3\n4\n"
    }
  ],
  "hint": "新矩阵第 j 行来自原矩阵第 j 列的逆序。",
  "source": "Atelier OJ 分级题库",
  "tags": [
    "矩阵",
    "模拟"
  ],
  "time_limit": 2.0,
  "memory_limit": 256,
  "author": "Atelier OJ",
  "difficulty": "简单",
  "public_cases": false
}
