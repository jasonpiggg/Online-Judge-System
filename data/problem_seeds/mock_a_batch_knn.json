      "output": "0\n1\n1\n"
    },
    {
      "input": "3 2 4 2\n0 0 0\n2 0 1\n0 2 1\n0 0\n1 2\n2 1\n0 0\n",
      "output": "0\n0\n0\n0\n"
    },
    {
      "input": "3 2 5 3\n0 0 0\n2 0 1\n0 2 1\n0 0\n1 2\n2 1\n0 0\n1 2\n",
      "output": "1\n1\n1\n1\n1\n"
    },
    {
      "input": "3 2 6 1\n0 0 0\n2 0 1\n0 2 1\n0 0\n1 2\n2 1\n0 0\n1 2\n2 1\n",
      "output": "0\n1\n1\n0\n1\n1\n"
    },
    {
      "input": "3 2 7 2\n0 0 0\n2 0 1\n0 2 1\n0 0\n1 2\n2 1\n0 0\n1 2\n2 1\n0 0\n",
