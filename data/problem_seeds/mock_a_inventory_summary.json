{
  "id": "mock_a_inventory_summary",
  "title": "仓库盘点汇总",
  "description": "汇总多种商品的库存件数和库存金额，金额均为整数分。",
  "input_description": "第一行 n；随后每行商品编号、数量、单价。",
  "output_description": "输出总件数和总金额。",
  "samples": [
    {
      "input": "1\np0 1 10\n",
      "output": "1 10\n"
    },
    {
      "input": "2\np0 1 10\np1 2 11\n",
      "output": "3 32\n"
    }
  ],
  "constraints": "1 ≤ n ≤ 100000，数量与单价非负。",
