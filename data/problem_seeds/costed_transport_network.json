{
  "id": "costed_transport_network",
  "title": "带费用运输网络",
  "description": "从若干仓库向若干门店运输，满足全部需求且不超过供给，求最小运输费用。",
  "input_description": "第一行 n m；第二行供给，第三行需求；随后 n 行单位费用矩阵。",
  "output_description": "输出满足需求的最小总费用。",
  "samples": [
    {
      "input": "1 1\n5\n3\n2\n",
      "output": "6\n"
    },
    {
      "input": "2 2\n3 3\n2 4\n1 5\n4 2\n",
      "output": "13\n"
    }
  ],
  "constraints": "总供给不少于总需求，n,m ≤ 30，数量非负。",
  "testcases": [
    {
      "input": "1 1\n5\n3\n2\n",
      "output": "6\n"
    },
    {
      "input": "2 2\n3 3\n2 4\n1 5\n4 2\n",
      "output": "13\n"
    },
    {
      "input": "2 1\n2 5\n6\n3\n1\n",
      "output": "8\n"
    },
    {
      "input": "1 3\n10\n2 3 1\n5 1 4\n",
      "output": "17\n"
    },
    {
      "input": "3 2\n2 2 2\n3 3\n1 9\n4 4\n9 1\n",
      "output": "12\n"
    }
  ],
  "hint": "建立源点、仓库、门店和汇点的最小费用流网络。",
  "source": "Atelier OJ 分级题库",
  "tags": [
    "最小费用最大流",
    "网络流"
  ],
  "time_limit": 2.0,
  "memory_limit": 256,
  "author": "Atelier OJ",
  "difficulty": "挑战",
  "public_cases": false
}
