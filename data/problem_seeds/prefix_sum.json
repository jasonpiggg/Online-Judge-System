  "samples": [{"input": "5 3\n1 2 3 4 5\n1 3\n2 5\n3 3\n", "output": "6\n14\n3\n"}],
  "constraints": "1 ≤ n,q ≤ 100000；|a_i| ≤ 1000000000；1 ≤ l ≤ r ≤ n。",
  "testcases": [
