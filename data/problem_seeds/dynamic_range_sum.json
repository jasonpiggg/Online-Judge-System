{
  "id": "dynamic_range_sum",
  "title": "动态区间和",
  "description": "维护整数序列，支持单点赋值和闭区间求和。",
  "input_description": "第一行 n q，第二行数组；操作 U i x 或 Q l r。",
  "output_description": "每个 Q 输出区间和。",
  "samples": [
    {
      "input": "3 3\n1 2 3\nQ 1 3\nU 2 5\nQ 2 3\n",
      "output": "6\n8\n"
    },
    {
      "input": "1 2\n-2\nQ 1 1\nU 1 0\n",
      "output": "-2\n"
    }
  ],
  "constraints": "1 ≤ n,q ≤ 200000。",
  "testcases": [
    {
      "input": "3 3\n1 2 3\nQ 1 3\nU 2 5\nQ 2 3\n",
      "output": "6\n8\n"
    },
    {
      "input": "1 2\n-2\nQ 1 1\nU 1 0\n",
      "output": "-2\n"
    },
    {
      "input": "4 4\n0 0 0 0\nU 4 9\nQ 1 4\nU 1 -3\nQ 1 1\n",
      "output": "9\n-3\n"
    },
    {
      "input": "5 2\n1 2 3 4 5\nQ 3 3\nQ 2 5\n",
      "output": "3\n14\n"
    },
    {
      "input": "2 3\n10 -10\nQ 1 2\nU 1 7\nQ 1 2\n",
      "output": "0\n-3\n"
    }
  ],
  "hint": "树状数组维护差值更新。",
  "source": "Atelier OJ 分级题库",
  "tags": [
    "树状数组",
    "数据结构"
  ],
  "time_limit": 2.0,
  "memory_limit": 256,
