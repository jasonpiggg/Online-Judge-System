      "output": "u02 100\nu01 65\nu00 30\n"
    },
    {
      "input": "4\nu00 18 3000 0\nu01 19 3700 1\nu02 20 4400 2\nu03 21 5100 3\n",
      "output": "u03 115\nu02 100\nu01 65\nu00 30\n"
    },
    {
      "input": "5\nu00 18 3000 0\nu01 19 3700 1\nu02 20 4400 2\nu03 21 5100 3\nu04 22 5800 0\n",
