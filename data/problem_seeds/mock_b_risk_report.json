{
  "id": "mock_b_risk_report",
  "title": "风险评分报表",
  "description": "为每位用户计算规则风险分：每次逾期 35 分，收入低于 5000 加 20 分，年龄低于 25 加 10 分；按风险分降序、用户 ID 升序生成报表。允许使用 pandas.DataFrame、布尔索引、sort_values。",
  "input_description": "第一行 n；随后每行 user_id age income overdue。",
  "output_description": "逐行输出 user_id 和风险分。",
  "samples": [
    {
      "input": "1\nu00 18 3000 0\n",
      "output": "u00 30\n"
    },
    {
      "input": "2\nu00 18 3000 0\nu01 19 3700 1\n",
      "output": "u01 65\nu00 30\n"
    }
  ],
  "constraints": "1 ≤ n ≤ 200000，各字段为整数且 user_id 唯一。",
  "testcases": [
    {
      "input": "1\nu00 18 3000 0\n",
      "output": "u00 30\n"
    },
    {
      "input": "2\nu00 18 3000 0\nu01 19 3700 1\n",
      "output": "u01 65\nu00 30\n"
    },
    {
