{
  "id": "range_update_query",
  "title": "区间修改与查询",
  "description": "维护数组，支持区间加法和区间求和。",
  "input_description": "第一行 n q，第二行数组；操作 ADD l r x 或 SUM l r。",
  "output_description": "每个 SUM 输出一行。",
  "samples": [
    {
      "input": "3 3\n1 2 3\nSUM 1 3\nADD 1 2 4\nSUM 2 3\n",
      "output": "6\n9\n"
    },
    {
      "input": "1 3\n0\nADD 1 1 -2\nSUM 1 1\nSUM 1 1\n",
      "output": "-2\n-2\n"
    }
  ],
  "constraints": "1 ≤ n,q ≤ 200000，答案在 64 位整数内。",
  "testcases": [
    {
      "input": "3 3\n1 2 3\nSUM 1 3\nADD 1 2 4\nSUM 2 3\n",
      "output": "6\n9\n"
    },
    {
      "input": "1 3\n0\nADD 1 1 -2\nSUM 1 1\nSUM 1 1\n",
      "output": "-2\n-2\n"
    },
    {
      "input": "4 4\n1 1 1 1\nADD 1 4 2\nSUM 1 4\nADD 2 3 -1\nSUM 2 3\n",
      "output": "12\n4\n"
    },
    {
      "input": "5 2\n5 4 3 2 1\nSUM 3 5\nADD 1 5 100\n",
      "output": "6\n"
    },
    {
      "input": "2 3\n-5 5\nSUM 1 2\nADD 2 2 -5\nSUM 1 2\n",
      "output": "0\n-5\n"
    }
  ],
  "hint": "线段树用懒标记下传区间增量。",
  "source": "Atelier OJ 分级题库",
  "tags": [
    "线段树",
    "懒标记"
  ],
  "time_limit": 2.0,
  "memory_limit": 256,
  "author": "Atelier OJ",
  "difficulty": "困难",
  "public_cases": false
}
